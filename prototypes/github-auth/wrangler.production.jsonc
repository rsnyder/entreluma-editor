{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "entreluma-editor",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-06",
  "assets": {
    "directory": "./.editor-assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "APP_ORIGIN": "https://editor.entreluma.org",
    "GITHUB_CLIENT_ID": "Ov23liZbMEQx4vvyGdoJ",
    "GITHUB_SCOPE": "repo",
    "EDITOR_ONLY": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "storykit-editor",
      "database_id": "8705eb27-3300-40e6-afc6-05cf54f01694",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  },
  "observability": {
    "enabled": false
  },
  "build": {
    "command": "node tools/build-editor.mjs"
  },
  "routes": [
    {
      "pattern": "editor.entreluma.org",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "account_id": "f9a486f2c4e5234040005c2d2f9a4b97"
}
